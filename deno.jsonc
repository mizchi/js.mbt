{
  "name": "@mizchi/moonjs",
  "tasks": {
    // mizchi/js_deno integration tests. They are a compiled MoonBit test
    // bundle, so the debug build has to exist first (see "test.include").
    "test:deno": "moon build --target js && deno test -A",
    // mizchi/js_convert TypeScript tests. interop.test.ts imports the
    // *release* build of the _interop_test executable, so it needs a
    // different build than "test:deno" and cannot share "test.include".
    "test:convert": "moon build --target js --release && deno test -A modules/js_convert/interop.test.ts modules/js_convert/types.test.ts",
    "test:all": "deno task test:deno && deno task test:convert"
  },
  "test": {
    "include": [
      "_build/js/debug/build/mizchi/js_deno/_tests/_tests.js"
    ],
  },
  "exports": {}
}
